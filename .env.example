# Ralph environment variables
# Copy to .env or export in your shell. 
# Env vars override built-in defaults.

# Backend to use: claude | codex
RALPH_BACKEND=claude

# Max loop iterations
RALPH_LOOP_LIMIT=30

# Path to the findings log file
RALPH_FINDINGS_PATH=./findings.txt

# Minutes to wait on rate limit
RALPH_RATE_LIMIT=15

# Max parallel operations (available for backends/scripts)
RALPH_MAX_PARALLEL=4

# Enable verbose/debug logging (true or 1)
RALPH_VERBOSE=false

# Show resolved config and exit without running (true or 1)
RALPH_DRY_RUN=false

# Disable spinner (true or 1)
RALPH_NO_SPINNER=false

# Deterministic timestamp command (useful for tests)
# Example: RALPH_NOW_CMD="printf '2000-01-01T00:00:00Z'"
RALPH_NOW_CMD=

# Replace sleep command for tests (e.g., ":" to skip delays)
SLEEP_CMD=

# Override backend command paths (e.g., to use test fakes)
CLAUDE_CMD=
CODEX_CMD=
