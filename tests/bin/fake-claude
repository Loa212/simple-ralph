#!/usr/bin/env bash
set -euo pipefail

fixture_path=""

if [[ -n "${FIXTURE_SEQUENCE:-}" ]]; then
  if [[ -z "${FIXTURE_STATE_FILE:-}" ]]; then
    FIXTURE_STATE_FILE="${TMPDIR:-/tmp}/ralph-fixture-state"
  fi
  IFS=':' read -r -a fixtures <<< "$FIXTURE_SEQUENCE"
  fixture_index=0
  if [[ -f "$FIXTURE_STATE_FILE" ]]; then
    fixture_index="$(cat "$FIXTURE_STATE_FILE" 2>/dev/null || echo 0)"
  fi
  if [[ ! "$fixture_index" =~ ^[0-9]+$ ]]; then
    fixture_index=0
  fi
  if [[ "$fixture_index" -ge "${#fixtures[@]}" ]]; then
    fixture_index=$((${#fixtures[@]} - 1))
  fi
  fixture_path="${fixtures[$fixture_index]}"
  printf '%s' "$((fixture_index + 1))" > "$FIXTURE_STATE_FILE"
else
  fixture_path="${FIXTURE:-}"
fi

if [[ -z "$fixture_path" ]]; then
  echo "fake-claude: FIXTURE env var is required" >&2
  exit 2
fi

if [[ ! -f "$fixture_path" ]]; then
  echo "fake-claude: fixture not found: $fixture_path" >&2
  exit 2
fi

stream_delay="${STREAM_DELAY_SECONDS:-0}"

test_sleep() {
  local duration="${1:-}"
  if [[ -n "${SLEEP_CMD:-}" ]]; then
    # shellcheck disable=SC2086,SC2294
    eval "$SLEEP_CMD" "$duration"
  else
    sleep "$duration"
  fi
}

while IFS= read -r line || [[ -n "$line" ]]; do
  printf '%s\n' "$line"
  if [[ "$stream_delay" != "0" && -n "$stream_delay" ]]; then
    test_sleep "$stream_delay"
  fi
done < "$fixture_path"
